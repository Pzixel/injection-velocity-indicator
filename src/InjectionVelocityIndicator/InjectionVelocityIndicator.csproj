<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>InjectionVelocityIndicator</AssemblyName>
    <RootNamespace>InjectionVelocityIndicator</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <KSPRoot Condition="'$(KSPRoot)' == '' and '$(KSP_DIR)' != ''">$(KSP_DIR)</KSPRoot>
    <KSPRoot Condition="'$(KSPRoot)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program\KSP_x64_Data\Managed\Assembly-CSharp.dll')">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KSPRoot>
    <KSPManagedDir>$(KSPRoot)\KSP_x64_Data\Managed</KSPManagedDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(KSPRoot)\GameData\000_Harmony\0Harmony.dll</HarmonyPath>
    <PackageDir>$(MSBuildProjectDirectory)\..\..\GameData\InjectionVelocityIndicator\Plugins</PackageDir>
  </PropertyGroup>

  <Target Name="ValidateKspReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(KSPManagedDir)\Assembly-CSharp.dll')" Text="KSP 1.12.5 Assembly-CSharp.dll was not found. Set KSP_DIR or pass -p:KSPRoot=&quot;path to Kerbal Space Program&quot;." />
    <Error Condition="!Exists('$(HarmonyPath)')" Text="HarmonyKSP was not found at $(HarmonyPath). Install CKAN package Harmony2 or pass -p:HarmonyPath=&quot;path to 0Harmony.dll&quot;." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSPManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KSPManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PrepareReleaseGameData" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDir)" />
  </Target>
</Project>
